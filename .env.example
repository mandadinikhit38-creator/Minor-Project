# Optional provider credentials. The app works without either API key.
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=

# In-memory per-client rate limit (single-process deployment only).
SCAN_RATE_LIMIT=10
SCAN_RATE_WINDOW_SECONDS=60

# Optional path to a newline-separated local URL/domain feed.
OPENPHISH_FEED_FILE=data/known_phishing_domains.txt

# Optional trained PyTorch URL classifier (install requirements-ml.txt to train/use).
PHISHLENS_MODEL_PATH=models/url_cnn.pt
ML_PHISHING_THRESHOLD=0.8
